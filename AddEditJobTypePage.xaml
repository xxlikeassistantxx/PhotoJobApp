<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PhotoJobApp.AddEditJobTypePage"
             xmlns:models="clr-namespace:PhotoJobApp.Models"
             x:DataType="models:JobType"
             Title="{Binding Id, StringFormat='Edit Job Type', TargetNullValue='New Job Type'}"
             BackgroundColor="#F0F0F0">

    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <StackLayout Padding="10" Spacing="10">

            <Border Padding="15" Background="White">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <StackLayout Spacing="10">
                    <Label Text="Basic Information" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Name *"/>
                    <Entry Text="{Binding Name}" Placeholder="e.g., Wedding Photography"/>
                    <Label Text="Description"/>
                    <Editor Text="{Binding Description}" Placeholder="A short description of this job type" HeightRequest="80" AutoSize="TextChanges"/>
                    <Label Text="Icon"/>
                    <Entry Text="{Binding Icon}" Placeholder="e.g., 📷"/>
                    <Label Text="Color"/>
                    <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5" Margin="0,5,0,0">
                        <!-- First row: Color swatches -->
                        <Border Grid.Row="0" Grid.Column="0" 
                               Background="#FF6B6B" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#FF6B6B">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color1Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="0" Text="Red" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="0" Grid.Column="1" 
                               Background="#4ECDC4" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#4ECDC4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color2Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="1" Text="Teal" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="0" Grid.Column="2" 
                               Background="#45B7D1" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#45B7D1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color3Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="2" Text="Blue" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="0" Grid.Column="3" 
                               Background="#96CEB4" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#96CEB4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color4Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="3" Text="Lime" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="0" Grid.Column="4" 
                               Background="#FFEAA7" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#FFEAA7">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color5Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="Black" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="4" Text="Yellow" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="0" Grid.Column="5" 
                               Background="#DDA0DD" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#DDA0DD">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color6Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="1" Grid.Column="5" Text="Magenta" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <!-- Second row of colors -->
                        <Border Grid.Row="2" Grid.Column="0" 
                               Background="#512BD4" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#512BD4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color7Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="3" Grid.Column="0" Text="Purple" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="2" Grid.Column="1" 
                               Background="#2196F3" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#2196F3">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color8Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="3" Grid.Column="1" Text="Blue" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="2" Grid.Column="2" 
                               Background="#4CAF50" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#4CAF50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color9Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="3" Grid.Column="2" Text="Green" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="2" Grid.Column="3" 
                               Background="#FF9800" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#FF9800">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color10Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="3" Grid.Column="3" Text="Orange" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="2" Grid.Column="4" 
                               Background="#E91E63" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#E91E63">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color11Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="3" Grid.Column="4" Text="Pink" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                        
                        <Border Grid.Row="2" Grid.Column="5" 
                               Background="#9E9E9E" 
                               HeightRequest="50" 
                               WidthRequest="50" 
                               Padding="0"
                               AutomationId="#9E9E9E">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColorSelected"/>
                            </Border.GestureRecognizers>
                            <Label x:Name="Color12Check" Text="✓" 
                                   FontSize="24" 
                                   FontAttributes="Bold"
                                   TextColor="White" 
                                   HorizontalOptions="Center" 
                                   VerticalOptions="Center"
                                   IsVisible="False"/>
                        </Border>
                        <Label Grid.Row="3" Grid.Column="5" Text="Gray" FontSize="12" HorizontalOptions="Center" TextColor="Gray"/>
                    </Grid>
                </StackLayout>
            </Border>

            <Border Padding="15" Background="White">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <StackLayout Spacing="10">
                    <Label Text="Enabled Features" FontSize="18" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                        <Label Grid.Row="0" Grid.Column="0" Text="Include Photos" VerticalOptions="Center"/>
                        <Switch Grid.Row="0" Grid.Column="1" IsToggled="{Binding HasPhotos}" OnColor="#512BD4"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="Include Location" VerticalOptions="Center"/>
                        <Switch Grid.Row="1" Grid.Column="1" IsToggled="{Binding HasLocation}" OnColor="#512BD4"/>
                        <Label Grid.Row="2" Grid.Column="0" Text="Include Client Information" VerticalOptions="Center"/>
                        <Switch Grid.Row="2" Grid.Column="1" IsToggled="{Binding HasClientInfo}" OnColor="#512BD4"/>
                        <Label Grid.Row="3" Grid.Column="0" Text="Include Pricing" VerticalOptions="Center"/>
                        <Switch Grid.Row="3" Grid.Column="1" IsToggled="{Binding HasPricing}" OnColor="#512BD4"/>
                        <Label Grid.Row="4" Grid.Column="0" Text="Include Due Date" VerticalOptions="Center"/>
                        <Switch Grid.Row="4" Grid.Column="1" IsToggled="{Binding HasDueDate}" OnColor="#512BD4"/>
                        <Label Grid.Row="5" Grid.Column="0" Text="Include Status" VerticalOptions="Center"/>
                        <Switch Grid.Row="5" Grid.Column="1" IsToggled="{Binding HasStatus}" OnColor="#512BD4"/>
                        <Label Grid.Row="6" Grid.Column="0" Text="Include Notes" VerticalOptions="Center"/>
                        <Switch Grid.Row="6" Grid.Column="1" IsToggled="{Binding HasNotes}" OnColor="#512BD4"/>
                        <Label Grid.Row="7" Grid.Column="0" Text="Include Urgent Flag" VerticalOptions="Center"/>
                        <Switch Grid.Row="7" Grid.Column="1" IsToggled="{Binding HasUrgentFlag}" OnColor="#512BD4"/>
                    </Grid>
                </StackLayout>
            </Border>

            <Border Padding="15" Background="White">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <StackLayout Spacing="10">
                    <Label Text="Status Options" FontSize="18" FontAttributes="Bold"/>
                    <Label Text="Enter status options separated by commas." FontSize="12" TextColor="#666666"/>
                    <Editor Text="{Binding StatusOptions}" Placeholder="e.g., Pending, In Progress, Completed" HeightRequest="60" AutoSize="TextChanges"/>
                </StackLayout>
            </Border>

            <CollectionView ItemsSource="{Binding CustomFieldsList}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CustomField">
                        <Border Margin="0,5" Padding="10" Background="White">
                            <Border.StrokeShape><RoundRectangle CornerRadius="5"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" FontAttributes="Bold"/>
                                    <Label FontSize="12" TextColor="#666666">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Type, StringFormat='Type: {0}'}"/>
                                                <Span Text=" | "/>
                                                <Span Text="{Binding Required, StringFormat='Required: {0}'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </StackLayout>
                                <Button Grid.Column="1" Text="🗑️" BackgroundColor="Transparent" TextColor="Red" Clicked="OnDeleteCustomFieldClicked" CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Add Custom Field Button -->
            <Border Padding="15" Background="White">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <StackLayout Spacing="10">
                    <Label Text="Custom Fields" FontSize="18" FontAttributes="Bold"/>
                    <Button Text="+ Add Custom Field" 
                            Clicked="OnAddCustomFieldClicked"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            CornerRadius="5"/>
                </StackLayout>
            </Border>

            <!-- Save and Cancel Buttons -->
            <Border Padding="15" Background="White">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="15">
                    <Button Text="Save" 
                            Clicked="OnSaveClicked"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            WidthRequest="120"
                            CornerRadius="5"/>
                    <Button Text="Cancel" 
                            Clicked="OnCancelClicked"
                            BackgroundColor="Gray"
                            TextColor="White"
                            WidthRequest="120"
                            CornerRadius="5"/>
                </StackLayout>
            </Border>

        </StackLayout>
    </ScrollView>
</ContentPage> 