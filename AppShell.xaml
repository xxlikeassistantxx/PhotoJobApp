<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PhotoJobApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PhotoJobApp"
    Title="Photo Job Manager">

    <Shell.MenuBarItems>
        <MenuBarItem Text="Account">
            <MenuFlyoutItem Text="View Logs" Clicked="OnViewLogsClicked" />
            <MenuFlyoutItem Text="Sign Out" Clicked="OnSignOutClicked" />
        </MenuBarItem>
    </Shell.MenuBarItems>

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="➕ Create New Job"
        ContentTemplate="{DataTemplate local:AddEditJobPage}"
        Route="AddEditJobPage" />

    <ShellContent
        Title="📋 Create Job Type"
        ContentTemplate="{DataTemplate local:AddEditJobTypePage}"
        Route="AddEditJobTypePage" />

    <ShellContent
        Title="🔍 Search &amp; Filter"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPageSearch" />

    <ShellContent
        Title="📈 Job Analysis"
        ContentTemplate="{DataTemplate local:JobAnalysisPage}"
        Route="JobAnalysisPage" />

    <ShellContent
        Title="⚙️ Job Type Management"
        ContentTemplate="{DataTemplate local:JobTypeManagementPage}"
        Route="JobTypeManagementPage" />

    <ShellContent
        Title="👤 Account Management"
        ContentTemplate="{DataTemplate local:AccountPage}"
        Route="AccountPage" />

    <ShellContent
        Title="☁️ Cloud Management"
        ContentTemplate="{DataTemplate local:CloudManagementPage}"
        Route="CloudManagementPage" />

</Shell>
