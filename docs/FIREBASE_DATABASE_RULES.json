{
  "rules": {
    // User's own job types - only the owner can read/write
    "jobTypes": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    
    // User's own jobs - only the owner can read/write
    "jobs": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    
    // Shared jobs - accessible by linked accounts
    "sharedJobs": {
      "$uid": {
        "jobs": {
          "$jobId": {
            // Allow read if user is the owner OR if they're linked to the owner
            ".read": "$uid === auth.uid || root.child('linkedAccounts').child(auth.uid).child('linkedUserIds').child($uid).exists()",
            // Only the owner can write
            ".write": "$uid === auth.uid"
          }
        }
      }
    },
    
    // Shared job types - accessible by linked accounts
    "sharedJobTypes": {
      "$uid": {
        "jobTypes": {
          "$jobTypeId": {
            // Allow read if user is the owner OR if they're linked to the owner
            ".read": "$uid === auth.uid || root.child('linkedAccounts').child(auth.uid).child('linkedUserIds').child($uid).exists()",
            // Only the owner can write
            ".write": "$uid === auth.uid"
          }
        }
      }
    },
    
    // Account linking - users can read their own links and write to create links
    "linkedAccounts": {
      "$uid": {
        "linkedUserIds": {
          ".read": "$uid === auth.uid",
          ".write": "$uid === auth.uid"
        }
      }
    },
    
    // User records - users can read/write their own record
    "users": {
      "$userId": {
        ".read": "$userId === auth.uid || root.child('linkedAccounts').child(auth.uid).child('linkedUserIds').child($userId).exists()",
        ".write": "$userId === auth.uid"
      }
    }
  }
}

